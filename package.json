{
  "name": "meow-rush-gauntlet",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "description": "Meow Rush: Gauntlet - turn-based cat-vs-dog tower climber.",
  "author": "NJM Ventures",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "build:full": "vite build --mode full --outDir dist-full",
    "build:release": "vite build && node tools/obfuscate-build.mjs",
    "preview": "vite preview",
    "electron:start": "npm run build:full && electron .",
    "electron:build": "npm run build:full && electron-builder --win portable",
    "sprites": "node tools/export-sprites.mjs",
    "sprites:dogs": "node tools/export-dog-sprites.mjs",
    "sprites:verify": "node tools/verify-sprite-assets.mjs",
    "sfx:verify": "node tools/verify-sfx-assets.mjs",
    "music:themes": "node tools/prepare-theme-music.mjs",
    "music:battle": "node tools/prepare-battle-phonk.mjs",
    "music:doggod": "node tools/convert-doggod.mjs",
    "pwa-icons": "node tools/generate-pwa-icons.mjs"
  },
  "build": {
    "appId": "com.njmventures.meowrushgauntlet",
    "productName": "Meow Rush Gauntlet",
    "directories": { "output": "dist-electron" },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [{ "from": "dist-full", "to": "app" }],
    "win": { "target": "portable" },
    "portable": { "artifactName": "MeowRushGauntlet-${version}.exe" }
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^5.4.3",
    "playwright": "^1.52.0",
    "vite": "^6.3.5"
  }
}
